APP_ENV=development
FRONTEND_ORIGINS=http://localhost:5173
# Plazo del bucle de puertos, no timeout global del trabajo.
SCAN_MAX_SECONDS=180
PORT_SCAN_TIMEOUT_SECONDS=0.25
PORT_SCAN_CONCURRENCY=200
RATE_LIMIT_SCANS=5
RATE_LIMIT_WINDOW_SECONDS=300
# Ruta relativa al cwd backend/: no ejecutar el servidor desde la raiz.
DATABASE_URL=sqlite+aiosqlite:///../data/domaincheck.db
HISTORY_RETENTION_DAYS=90
SUBDOMAIN_RESULT_LIMIT=100

# Enriquecimiento opcional
VIRUSTOTAL_API_KEY=
SECURITYTRAILS_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
MDN_OBSERVATORY_ENABLED=false
